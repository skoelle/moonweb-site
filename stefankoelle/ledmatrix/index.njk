              <th>Features</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Microcontroller</strong></td>
              <td>NodeMCU-32S ESP32</td>
              <td>32-Bit Dual-Core 240MHz, WiFi + Bluetooth</td>
            </tr>
