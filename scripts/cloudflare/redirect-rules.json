[
  {
    "expression": "http.host eq \"hub.moonweb.org\"",
    "description": "hub.moonweb.org -> www.moonweb.org",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "target_url": {
          "expression": "concat(\"https://www.moonweb.org\", http.request.uri.path)"
        },
        "status_code": 301,
        "preserve_query_string": true
      }
    }
  },
